{
  "mcpServers": {
    "subagentbridge": {
      "command": "python",
      "args": ["-m", "subagentbridge.server"],
      "env": {
        "SUBAGENTBRIDGE_DB_PATH": "%USERPROFILE%\\.subagentbridge\\sessions.db",
        "SUBAGENTBRIDGE_MAX_RETRIES": "2",
        "SUBAGENTBRIDGE_DEFAULT_TIMEOUT_S": "600"
      }
    }
  }
}
